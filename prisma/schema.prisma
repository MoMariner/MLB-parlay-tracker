generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One record per player referenced by any bet, across sports.
///
/// Keyed "<sport>:<league id>" (e.g. "mlb:592450", "nfl:12483"). MLB and ESPN
/// ids are independent number spaces, so a bare integer key could collide;
/// the prefix makes that impossible by construction.
model Player {
  key          String   @id
  sport        String   @default("mlb")
  /// The league's own id -- MLB people.id, or ESPN athlete id for the NFL.
  id           Int
  fullName     String
  teamId       Int?
  teamName     String?
  teamAbbrev   String?
  position     String? // abbreviation, e.g. "RF", "P", "QB", "WR"
  positionType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bets Bet[]

  @@unique([sport, id])
}

/// One record per game referenced by any bet, across sports.
/// Keyed "<sport>:<event id>". The poller runs one feed request per game key.
model Game {
  key           String   @id
  sport         String   @default("mlb")
  /// MLB gamePk, or ESPN event id for the NFL.
  gamePk        Int
  gameDate      DateTime
  officialDate  String
  status        String // "Preview" | "Live" | "Final" | "Other"
  detailedState String?
  homeTeamId    Int
  homeName      String
  homeAbbrev    String
  awayTeamId    Int
  awayName      String
  awayAbbrev    String
  homeScore     Int?
  awayScore     Int?
  homeLogo      String?
  awayLogo      String?

  // ---- MLB situation ----
  inning             Int?
  inningState        String?
  outs               Int?
  balls              Int?
  strikes            Int?
  onFirst            Boolean @default(false)
  onSecond           Boolean @default(false)
  onThird            Boolean @default(false)
  currentPitcherId   Int?
  currentPitcherName String?

  // ---- NFL situation ----
  /// Quarter; 5 and up is overtime.
  period           Int?
  clock            String?
  possessionTeamId Int?
  down             Int?
  distance         Int?
  /// Yards the offense still needs for a touchdown, 0-100.
  yardsToEndzone   Int?
  downDistanceText String?
  isRedZone        Boolean @default(false)
  lastPlay         String?
  /// JSON arrays of per-quarter points.
  homeLinescores   String?
  awayLinescores   String?
  /// ESPN's live win probability for the home side, 0..1.
  homeWinProb      Float?
  /// Pregame market total and spread (home perspective), the priors for
  /// game-line win probability.
  marketTotal      Float?
  marketSpread     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets Bet[]

  @@unique([sport, gamePk])
}

/// A bet slip: one or more legs that must ALL hit. A straight single bet is
/// just a one-leg slip, so the dashboard can render everything the same way.
model Parlay {
  id     String @id @default(cuid())
  name   String?
  source String @default("manual")

  odds  Int?
  stake Float?
  /// Total return if the slip wins, entered directly. Takes precedence over
  /// `odds` for profit maths -- a book's quoted payout is the source of truth.
  payout Float?

  status String @default("PENDING") // PENDING | LIVE | WON | LOST

  /// Live estimated chance every remaining leg hits, 0..1. Recomputed each poll.
  winProbability Float?

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bets    Bet[]
  history ParlayPoint[]
}

/// One sample of a slip's win probability, so the card can draw where the
/// number has been and say what moved it.
model ParlayPoint {
  id          String   @id @default(cuid())
  parlayId    String
  probability Float
  /// Short human explanation of the move, e.g. "Soto +1 Total Bases".
  reason      String?
  /// JSON map of betId -> currentValue at this sample, used to diff the next one.
  legValues   String
  createdAt   DateTime @default(now())

  parlay Parlay @relation(fields: [parlayId], references: [id], onDelete: Cascade)

  @@index([parlayId, createdAt])
}

model Bet {
  id    String @id @default(cuid())
  sport String @default("mlb")

  /// Null for game-level markets (totals, spreads, moneylines).
  playerKey String?
  playerId  Int?
  gameKey   String
  gamePk    Int
  /// The team a player plays for, or the side picked on a spread, moneyline
  /// or team total. Null for a whole-game total.
  teamId    Int?

  betType   String // PropKey, e.g. "HITS" | "NFL_PASS_YARDS" | "NFL_GAME_TOTAL"
  source    String @default("manual")
  /// OVER | UNDER, or TEAM for a spread / moneyline pick.
  direction String
  line      Float

  odds  Int?
  stake Float?

  status       String @default("PENDING") // PENDING | LIVE | WON | LOST | PUSH | VOID
  currentValue Float  @default(0)
  progress     Float  @default(0)

  /// Live estimated chance this leg hits, 0..1. Recomputed each poll.
  winProbability Float?
  /// Opportunities the player is projected to have left (PA, or batters faced).
  chancesLeft    Float?

  /// Slip this leg belongs to. Every bet gets one, even a straight single.
  parlayId String?

  /// JSON blob of the player's live stat line at last evaluation, so cards can
  /// render component stats without a refetch.
  statsSnapshot String?

  // ---- MLB display state ----
  battingStatus       String?
  battersAway         Int?
  expectedInning      Int?
  expectedHalf        String?
  expectedInningsLeft Float?
  workloadNote        String?
  shortLeash          Boolean @default(false)

  // ---- NFL display state ----
  /// ON_OFFENSE | ON_DEFENSE | RED_ZONE | NOT_IN_BOX_SCORE ...
  fieldStatus String?
  /// Where the stat projects to at the current rate, e.g. 312 passing yards.
  paceValue   Float?

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  player Player? @relation(fields: [playerKey], references: [key])
  game   Game    @relation(fields: [gameKey], references: [key])
  parlay Parlay? @relation(fields: [parlayId], references: [id], onDelete: Cascade)

  @@index([gameKey])
  @@index([status])
  @@index([parlayId])
}

/// Key/value store for app settings (polling interval, fantasy scoring
/// configs, display prefs). Values are JSON strings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
